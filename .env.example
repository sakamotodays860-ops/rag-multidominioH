# ---------------------------------------------------------------------------
# Plantilla de variables de entorno.
# Copiar este archivo a `.env` y completar los valores:
#     cp .env.example .env
# `.env` está en .gitignore y NO debe subirse al repositorio.
# ---------------------------------------------------------------------------

# --- Aplicación -------------------------------------------------------------
APP_NAME="Pipeline RAG Multi-Dominio"
APP_VERSION="0.1.0"
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=INFO

# --- PostgreSQL -------------------------------------------------------------
# Credenciales usadas tanto por el servicio `postgres` como por el backend.
POSTGRES_DB=rag_multidominio
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_PORT=5432

# URL de conexión usada por el backend (dentro de la red de Docker Compose).
# Formato: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://rag_user:cambiar_esta_clave@postgres:5432/rag_multidominio

# --- pgvector ---------------------------------------------------------------
# Dimension por defecto para los embeddings (VECTOR(768) en el esquema).
PGVECTOR_DIMENSION=768

# --- Scraping concurrente (FASE 3) ------------------------------------------
# Timeout de conexion/lectura por peticion HTTP.
HTTP_TIMEOUT_S=15.0
# Concurrencia maxima de descargas simultaneas (por defecto del endpoint).
HTTP_MAX_CONCURRENCIA=16
# Limite de bytes del cuerpo de una pagina descargada (proteccion de memoria).
HTTP_MAX_BYTES=2000000

# --- Chunking (FASE 3) -------------------------------------------------------
# Valores por defecto del endpoint POST /api/ingestar-web.
CHUNK_SIZE_POR_DEFECTO=1200
CHUNK_OVERLAP_POR_DEFECTO=200
URLS_POR_PETICION_MAX=50

# --- Gemini / embeddings (FASE 3) --------------------------------------------
# NO colocar aqui claves reales. Ninguna clave real se incluye en el repositorio.
GEMINI_API_KEY=
# Modelo de embeddings requerido por el enunciado (768 dims).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
# Numero maximo de textos por llamada a :batchEmbedContents (maximo 100).
GEMINI_BATCH_SIZE=100
# Reintentos FINITOS ante 429 / RESOURCE_EXHAUSTED (sin bucles infinitos).
GEMINI_MAX_REINTENTOS=5
GEMINI_BACKOFF_BASE_S=1.0
GEMINI_BACKOFF_MAX_S=30.0
GEMINI_TIMEOUT_S=60.0

# --- Modelo generativo y consulta RAG (FASE 4) --------------------------------
# Modelo de GENERACION de respuestas de /api/consultar.
GEMINI_MODEL=gemini-3.8-flash
# Modelo alternativo OPCIONAL ante un 503 UNAVAILABLE persistente del principal.
# Vacio = deshabilitado (comportamiento actual). La API de Gemini recomienda
# ante 503 recurrir temporalmente a otro modelo. Candidato estable verificado
# en la tabla oficial de modelos: gemini-3.6-flash. Requiere una prueba real
# autorizada antes de fijarlo en .env.
# GEMINI_MODEL_FALLBACK=gemini-3.6-flash
# Temperatura del LLM: 0.0 => respuestas deterministas (no cambiar).
GEMINI_TEMPERATURA=0.0
# Parametros por defecto de POST /api/consultar.
TOP_K_POR_DEFECTO=4
TOP_K_MAX=50
SIMILARITY_THRESHOLD_POR_DEFECTO=0.5
CONSULTA_PREGUNTA_MAX_CARACTERES=2000

# --- Recuperacion hibrida (mejora de recuperacion) ---------------------------
# La busqueda VECTORIAL se conserva SIEMPRE; la busqueda LEXICA (PostgreSQL
# nativo, diccionario `spanish`) la COMPLEMENTA. `true` combina ambas por RRF.
RECUPERACION_LEXICA=true
# Si el embedding de la pregunta falla (p.ej. cuota 429 agotada), continuar solo
# con la busqueda lexica (no requiere embeddings). `false` aborta la consulta.
RECUPERACION_LEXICA_SIN_EMBEDDING=true
# Parametro k de Reciprocal Rank Fusion (mayor k => menor peso del primer puesto).
HIBRIDO_RRF_K=60

# --- Chat conversacional -----------------------------------------------------
# Mapeo explicito y verificable dominio -> coleccion indexada.
COLECCION_FINANCIERA=financiero_bolivia_2026
COLECCION_TRIBUTARIA=tributario_bolivia_2026